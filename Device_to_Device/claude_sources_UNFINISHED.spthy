theory LAAFFI_Device_to_dl_phase
/*
 *  Author: Nikodem Witkiewicz
 *  Rules rewritten with pattern matching in In(...) (no dec/fst/snd/aead_verify in rules)
 *  + typing lemma [sources] for message variables (D_ID, kab, m, t) -> no partial deconstructions
 */
begin
builtins: hashing

functions: enc/4, dec/4
equations: dec(k, n, ad, enc(k, n, ad, m)) = m

rule Init_Device:
  [Fr(~params), Fr(~id)]
--[D_params(~params)]->
  [Device_params(~id,~params)]

rule Init_DL:
  []--[Only_once()]->[!DL()]

rule Pre_share_key:
  [Device_params(~id, params), Fr(~otID), Fr(~otk), !DL()]
--[]->
  [Device_otk(~id,~otID,params,~otk), Dl_otk(~otk, ~otID)]

// 1.
rule Device_send_params:
let
    P_array = h(params)
    k = h(P_array)
    c = enc(otk, ~nonce, ~ad, P_array)
    message = <c,~nonce, ~ad, otID>
in
  [Device_otk(~id, otID, params, otk), Fr(~nonce), Fr(~ad)]
--[Device_Params_sent(otk,~nonce,~ad,P_array,otID), Device_1_k(k)]->
  [Out(message), Device_1(P_array)]

//2.
rule DL_registers:
let
    c_old = enc(otk, nonce_old, ad_old, P_array)
    k = h(P_array)
    c_new = enc(k,~nonce_new,~ad_new,<~D_ID,~t_reg>)
    message = <c_new,~nonce_new,~ad_new>
in
  [In(<c_old,nonce_old,ad_old,otID>), Dl_otk(otk, otID)
  ,Fr(~D_ID), Fr(~t_reg), Fr(~ad_new), Fr(~nonce_new)]
--[DL_got_P(P_array)
  ,DL_finish_k(k)
  ,DL_finish_D_ID(~D_ID)
  ,DL_finish_otID(otID)]->
  [!DL_P_array(~D_ID, P_array), Out(message)]

//3
rule Device_finish:
let
    k = h(P_array)
    c = enc(k, nonce, ad, <D_ID, t>)
in
  [In(<c,nonce,ad>), Device_1(P_array)]
--[Device_finish_ID(D_ID)
  ,Device_finish_k(k)
  ,Device_finish_t(t)
  ,Device_finish_c(c)]->
  [!Device(D_ID,P_array)]

#ifdef malicious_insider
rule mal_get_params:
  [!DL_P_array(~D_ID, P_array)]--[]->[Out(P_array)]
#endif

rule Devices_can_talk:
  [!DL_P_array(D_ID1, P_array1), !DL_P_array(D_ID2, P_array2)]
--[Enable(D_ID1,D_ID2)]->
  [!Communication_enabled(D_ID1,D_ID2)]

rule Device_learn_ID:
  [!Device(D_ID1,P_array1),!Device(D_ID2,P_array2)]
--[]->
  [!Device_to_Device(D_ID1,P_array1,D_ID2)]

//1
rule DA_1:
let
    k = h(P_array)
    c = enc(k,~n,IDa,<IDb,~t>)
in
  [!Device_to_Device(IDa,P_array,IDb), Fr(~n), Fr(~t)]
--[DA_1_m(<~t>)
  ,DA_1_msg_sent(<IDb,~t>)
  ,DA_1_ID(IDa)
  ,DA_1_IDb(IDb)]->
  [DA_1(IDa,P_array,IDb), Out(<IDa, ~n, c>)]

//2
rule DL:
let
    ka = h(P_array_a)
    c_old = enc(ka, n_old, IDa, <IDb, t_old>)
    Kab = h(<P_array_b,IDa,IDb>)
    c_new = enc(ka,~n_new, IDa, <Kab,~t_new>)
in
  [In(<IDa, n_old, c_old>)
  ,!DL_P_array(IDa, P_array_a)
  ,!DL_P_array(IDb, P_array_b)
  ,!Communication_enabled(IDa,IDb)
  ,Fr(~n_new), Fr(~t_new)]
--[DL_t(t_old)
  ,DL_rcv_m(<IDb,t_old>)
  ,DL_ID(IDa)
  ,DL_m(Kab,~t_new)
  ,DL_send_m(<Kab,~t_new>)]->
  [Out(<IDa, ~n_new, c_new>)]

rule DA_3:
let
    ka = h(P_array)
    c_old = enc(ka, n_old, IDa, <kab, t_old>)
    c_new = enc(kab, ~n_new, IDb, <~res,~t_new>)
in
  [DA_1(IDa,P_array,IDb)
  ,In(<IDa, n_old, c_old>)
  ,Fr(~res), Fr(~n_new), Fr(~t_new)]
--[DA_3_t(t_old)
  ,DA_3_m(~res,~t_new)
  ,DA_3_rcv_m(<kab,t_old>)
  ,DA_3_received(IDa)
  ,DA_3_sent_to(IDb)
  ,DA_3_sent_m(<~res,~t_new>)]->
  [!D_to_D(IDa,IDb,kab),Out(<IDa, ~n_new, c_new>)]

rule DB_4:
let
  kab = h(<P_array_b,IDa,IDb>)
  c_old = enc(kab, n_old, IDb, <m, t_old>)
in
  [In(<IDa, n_old, c_old>)
  ,!Device(IDb, P_array_b)]
--[DB_4_t(t_old)
  ,DB_4_rcv_m(<m,t_old>)
  ,DB_4_received(IDa)]->
  [!D_to_D(IDb,IDa,kab)]

// 5
rule D_to_D_send:
let
    c = enc(kab,~n,ID1,<~m,~t>)
in
  [!D_to_D(ID1,ID2,kab), Fr(~n), Fr(~t), Fr(~m)]
--[D_to_D_m(~m,~t)
  ,D_to_D_sent_m(<~m,~t>)
  ,D_to_D_from_ID(ID1)
  ,D_to_D_to_ID(ID2)
  ,D_to_D_sent_n(~n)]->
  [Out(<c, ID1,~n>)]

rule D_to_D_rcv:
let
    c = enc(kab,n,ID2,<m,t>)
in
  [!D_to_D(ID1,ID2,kab), In(<c, ID2,n>)]
--[D_to_D_t(t)
  ,D_to_D_rcv_received(ID1)
  ,D_to_D_rcv_m(<m,t>)]->
  []

restriction Only_once:
"All #i #j. Only_once()@i & Only_once()@j ==> #i = #j"

restriction timestamp_unquiness_register_Dv_finish:
"All t #i #j . Device_finish_t(t)@i & Device_finish_t(t)@j ==> #i = #j"
restriction timestamp_unquiness_DL:
"All t #i #j . DL_t(t)@i & DL_t(t)@j ==> #i = #j"
restriction timestamp_unquiness_DA_3:
"All t #i #j . DA_3_t(t)@i & DA_3_t(t)@j ==> #i = #j"
restriction timestamp_unquiness_DB_4:
"All t #i #j . DB_4_t(t)@i & DB_4_t(t)@j ==> #i = #j"
restriction timestamp_unquiness_D_to_D_rcv:
"All t #i #j . D_to_D_t(t)@i & D_to_D_t(t)@j ==> #i = #j"

// ---------------------------------------------------------------
// SOURCES (typing) lemma: where message variables come from.
// ---------------------------------------------------------------
lemma types [sources, heuristic={sources}]:
"All D_ID #i. Device_finish_ID(D_ID)@i
   ==> (Ex #j. KU(D_ID)@j & #j < #i) | (Ex #j. DL_finish_D_ID(D_ID)@j)"

lemma types_P [sources, heuristic={sources}]:
"All P #i. DL_got_P(P)@i
   ==> (Ex #j. KU(P)@j & #j < #i)
     | (Ex otk n ad otID #j. Device_Params_sent(otk,n,ad,P,otID)@j)"

//Sanity
lemma executable:
exists-trace
"Ex k #i. Device_finish_k(k)@i"

lemma EX_Device_key_match_DL_key:
exists-trace
"Ex Device_key DL_key D_ID #i #j
  .DL_finish_k(DL_key)@i & DL_finish_D_ID(D_ID)@i
  &Device_finish_k(Device_key)@j & Device_finish_ID(D_ID)@j"

lemma key_secrecy:
"All k #i. Device_1_k(k)@i ==> not Ex #j. K(k)@j"

lemma DL_k_bind_D_ID:
"All k D_ID1 D_ID2 #i #j
  .DL_finish_k(k)@i & DL_finish_D_ID(D_ID1)@i
  &DL_finish_k(k)@j & DL_finish_D_ID(D_ID2)@j
  ==> D_ID1 = D_ID2"

lemma DL_D_ID_bin_k:
"All k1 k2 D_ID #i #j
  .DL_finish_k(k1)@i & DL_finish_D_ID(D_ID)@i
  &DL_finish_k(k2)@j & DL_finish_D_ID(D_ID)@j
  ==> k1 = k2"

lemma DL_k_bind_otID:
"All k otID1 otID2 #i #j
  .DL_finish_k(k)@i & DL_finish_otID(otID1)@i
  &DL_finish_k(k)@j & DL_finish_otID(otID2)@j
  ==> otID1 = otID2"

lemma DL_otID_bind_k:
"All k1 k2 otID #i #j
  .DL_finish_k(k1)@i & DL_finish_otID(otID)@i
  &DL_finish_k(k2)@j & DL_finish_otID(otID)@j
  ==> k1 = k2"

lemma No_forks:
"All k1 otID1 #i
  .DL_finish_k(k1)@i & DL_finish_otID(otID1)@i
  ==> (not Ex k2 #j. DL_finish_k(k2)@j & DL_finish_otID(otID1)@j & not k2 = k1)
    | (not Ex otID2 #j. DL_finish_k(k1)@j & DL_finish_otID(otID2)@j & not otID1 = otID2)"

lemma all_keys_in_DL_come_from_devices_params:
"All key #i . DL_finish_k(key)@i
  ==> Ex params #j. D_params(params)@j & key = h(h(params))"

lemma all_Device_keys_come_from_devices_params:
"All key #i . Device_finish_k(key)@i
  ==> Ex params #j. D_params(params)@j & key = h(h(params))"

lemma D_ID_binds_keys:
"All Device_key DL_key D_ID #i #j
  .DL_finish_k(DL_key)@i & DL_finish_D_ID(D_ID)@i
  &Device_finish_k(Device_key)@j & Device_finish_ID(D_ID)@j
  ==> DL_key = Device_key"

lemma key_bind_D_IDs:
"All key D_ID1 D_ID2 #i #j
  .DL_finish_k(key)@i & DL_finish_D_ID(D_ID1)@i
  &Device_finish_k(key)@j & Device_finish_ID(D_ID2)@j
  ==> D_ID1 = D_ID2"

lemma all_DL_keys_match_Device_keys1:
"All k #i. Device_finish_k(k)@i ==> Ex #j. DL_finish_k(k)@j"

lemma all_DL_keys_match_Device_keys2:
"All k #i. DL_finish_k(k)@i ==> Ex #j. Device_1_k(k)@j"

lemma Ex_Two_registered_devices:
exists-trace
"Ex ID1 ID2 #i #j .Device_finish_ID(ID1)@i &Device_finish_ID(ID2)@j"

lemma DA_1_m_secrecy:
"All m #i .DA_1_m(m)@i ==> not Ex #k. K(m)@k"

lemma DL_message_secrecy:
"All Kab t #i .DL_m(Kab, t)@i ==> (not Ex #k1 #k2. K(Kab)@k1 & K(t)@k2)"

lemma DA_3_message_secrecy:
"All res t #i .DA_3_m(res, t)@i ==> (not Ex #k1 #k2. K(res)@k1 & K(t)@k2)"

lemma D_to_D_m_message_secrecy:
"All m t #i .D_to_D_m(m, t)@i ==> (not Ex #k1 #k2. K(m)@k1 & K(t)@k2)"

lemma DL_auth:
"All m D_ID #i .DL_rcv_m(m)@i & DL_ID(D_ID)@i
  ==> (Ex #j. DA_1_msg_sent(m)@j & DA_1_ID(D_ID)@j & #j < #i)"

lemma DA_3_auth:
"All m #i .DA_3_rcv_m(m)@i ==> (Ex #j. DL_send_m(m)@j & #j < #i)"

lemma DB_4_auth:
"All m D_ID #i .DB_4_rcv_m(m)@i & DB_4_received(D_ID)@i
  ==> (Ex #j. DA_3_sent_m(m)@j & DA_3_sent_to(D_ID)@j & #j < #i)"

lemma D_to_D_auth:
"All m D_ID #i .D_to_D_rcv_m(m)@i & D_to_D_rcv_received(D_ID)@i
  ==> (Ex #j. D_to_D_sent_m(m)@j & D_to_D_from_ID(D_ID)@j & #j < #i)"

tactic: sources
presort: s
deprio:
    regex ".*enc.*"


end
